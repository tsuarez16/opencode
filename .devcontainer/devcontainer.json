{
	"name": "opencode",
	"image": "oven/bun:1.3.14",
	"postCreateCommand": "apt-get update && apt-get install -y build-essential python3 python-is-python3 git && bun install",
	"forwardPorts": [4096, 3000, 3001],
	"customizations": {
		"vscode": {
			"extensions": ["oven.bun-vscode"]
		}
	}
}
